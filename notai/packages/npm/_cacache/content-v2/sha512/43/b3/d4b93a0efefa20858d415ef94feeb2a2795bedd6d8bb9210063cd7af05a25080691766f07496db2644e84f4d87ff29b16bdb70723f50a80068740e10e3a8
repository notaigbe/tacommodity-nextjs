closing `</body>` tag:\n\n```html\n<script src=\"venobox/dist/venobox.min.js\"></script>\n```\n\n\n### Usage\n\nInsert one or more links with a custom class\n\n```html\n<a class=\"venobox\" href=\"image01-big.jpg\"><img src=\"image01-small.jpg\" alt=\"image alt\"/></a>\n```\n\nInitialize the plugin and your VenoBox is ready for all the selected links.\n\n```javascript\nnew VenoBox({\n  selector: '.venobox'\n});\n```\n\n## Documentation\n\nThe full documentation is available at https://veno.es/venobox/\n\nLicense: released under the MIT License\n","maintainers":[{"name":"nicolafranchini","email":"info@veno.es"}],"time":{"modified":"2024-04-26T12:59:06.389Z","created":"2017-02-27T17:09:19.943Z","1.7.0":"2017-02-27T17:09:19.943Z","1.7.2":"2017-03-16T23:18:55.512Z","1.8.0":"2017-04-23T17:52:59.847Z","1.8.1":"2017-05-12T23:53:24.256Z","1.8.2":"2017-06-26T12:29:12.545Z","1.8.3":"2018-03-18T22:56:08.530Z","1.8.4":"2018-08-18T12:44:42.365Z","1.8.5":"2018-08-27T00:25:16.353Z","1.8.6":"2019-06-27T12:16:02.552Z","1.8.7":"2020-03-15T21:14:33.242Z","1.8.8":"2020-03-16T22:40:26.423Z","1.8.9":"2020-03-18T04:02:49.813Z","1.9.0":"2020-05-23T15:34:45.942Z","1.9.1":"2020-08-13T01:08:47.909Z","1.9.2":"2020-12-30T21:33:14.871Z","1.9.3":"2021-03-15T19:27:33.279Z","1.9.4":"2021-11-16T12:06:44.901Z","2.0.0":"2021-12-02T18:38:19.221Z","2.0.1":"2021-12-07T23:49:19.437Z","2.0.2":"2021-12-13T09:55:13.409Z","2.0.3":"2021-12-13T10:18:55.932Z","2.0.4":"2021-12-16T16:34:16.949Z","2.0.5":"2023-11-17T10:59:08.157Z","2.0.6":"2023-11-17T11:44:15.393Z","2.0.7":"2023-11-18T23:20:39.336Z","2.0.8":"2023-11-19T01:18:57.149Z","2.0.9":"2023-11-28T12:32:57.137Z","2.1.0":"2023-12-01T23:10:40.548Z","2.1.1":"2023-12-02T01:45:43.730Z","2.1.2":"2023-12-04T17:52:08.532Z","2.1.3":"2023-12-04T22:50:23.826Z","2.1.4":"2024-01-02T12:15:48.795Z","2.1.5":"2024-01-22T12:16:16.650Z","2.1.6":"2024-01-24T23:09:07.367Z","2.1.7":"2024-04-08T09:42:48.295Z","2.1.8":"2024-04-26T12:59:06.203Z"},"homepage":"https://veno.es/venobox/"